; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Terraria"
run/main_scene="uid://drv5nrbnuw8ni"
config/features=PackedStringArray("4.6", "Forward Plus")

[autoload]

BetterTerrain="*uid://c4v2mtm0jyls2"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1200
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/better-terrain/plugin.cfg")

[global_group]

terrain="terrain features (proc. generation, environment etc.)"
sunlight=""

